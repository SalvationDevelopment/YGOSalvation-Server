{
  "name": "ygo-core-server-workspace",
  "private": true,
  "version": "0.1.0",
  "description": "TCP/WebSocket room server backed by ocgapi wasm",
  "type": "commonjs",
  "engines": {
    "node": ">=18"
  },
  "scripts": {
    "start": "node .\\server\\index.js",
    "server:start": "node .\\server\\index.js",
    "cms:dev": "set NODE_OPTIONS=--max-old-space-size=8192&& node .\\server\\cms\\index.js --dev",
    "cms:build": "next build .\\server\\cms --webpack",
    "cms:start": "set NODE_OPTIONS=--max-old-space-size=8192&& node .\\server\\cms\\index.js --prod",
    "cms:lint": "cd .\\server\\cms && eslint .",
    "cms:seed:dummy-users": "node .\\server\\cms\\scripts\\seed-dummy-users.mjs",
    "ui:styles": "sass .\\server\\ui\\app\\styles:.\\server\\ui\\public\\styles --no-source-map",
    "ui:dev": "next dev .\\server\\ui",
    "ui:build": "next build .\\server\\ui",
    "ui:start": "next start .\\server\\ui",
    "ui:lint": "cd .\\server\\ui && eslint .",
    "lint:server": "set ESLINT_USE_FLAT_CONFIG=false&& eslint .\\.eslintrc.js .\\server --ext .js --ignore-pattern server/ui --ignore-pattern server/core --ignore-pattern server/ocgcore --ignore-pattern server/scripts --ignore-pattern server/database",
    "lint": "npm run lint:server && npm run cms:lint && npm run ui:lint",
    "build:apps": "npm run cms:build && npm run ui:build",
    "dev:apps": "npm run cms:dev",
    "stack:start": "concurrently \"npm run server:start\" \"npm run cms:dev\"",
    "test": "npm run lint && npm run test:smoke",
    "test:auth": "node .\\tools\\scripts\\test-auth-flows.js",
    "test:duel-flow": "node .\\tools\\scripts\\test-duel-flow.js",
    "test:smoke": "npm run test:auth && npm run test:duel-flow",
    "test:boot": "node --test \"tests/boot/**/*.test.js\"",
    "test:unit:build": "node .\\tools\\build-test-bundle.js unit",
    "test:unit": "npm run test:unit:build && node --test \".tmp-tests/unit/**/*.test.js\"",
    "test:integration": "node --test --test-concurrency=1 \"tests/integration/**/*.test.js\"",
    "test:component:build": "node .\\tools\\build-test-bundle.js component",
    "test:component": "npm run test:component:build && node --test \".tmp-tests/component/**/*.test.js\"",
    "test:parity:build": "node .\\tools\\build-test-bundle.js parity",
    "test:parity": "npm run test:parity:build && node --test --test-concurrency=1 \".tmp-tests/parity/**/*.test.js\"",
    "test:functional:install": "playwright install",
    "test:functional": "playwright test tests/functional",
    "test:ci": "npm run lint && npm run test:boot && npm run test:unit && npm run test:integration && npm run test:component && npm run test:parity && npm run test:functional",
    "test:coverage:boot": "node --experimental-test-coverage --test \"tests/boot/**/*.test.js\"",
    "test:coverage:unit": "npm run test:unit:build && node --experimental-test-coverage --test \".tmp-tests/unit/**/*.test.js\"",
    "test:coverage:integration": "node --experimental-test-coverage --test --test-concurrency=1 \"tests/integration/**/*.test.js\"",
    "test:coverage:component": "npm run test:component:build && node --experimental-test-coverage --test \".tmp-tests/component/**/*.test.js\"",
    "test:coverage:parity": "npm run test:parity:build && node --experimental-test-coverage --test --test-concurrency=1 \".tmp-tests/parity/**/*.test.js\"",
    "test:coverage": "npm run test:coverage:boot && npm run test:coverage:unit && npm run test:coverage:integration && npm run test:coverage:component && npm run test:coverage:parity",
    "build": "node .\\tools\\build-ocgapi-emscripten.js Release",
    "build:debug": "node .\\tools\\build-ocgapi-emscripten.js Debug"
  },
  "dependencies": {
    "dotenv": "^16.4.7",
    "express": "^5.2.1",
    "jose": "^5.9.6",
    "mongoose": "^8.19.3",
    "next": "16.1.6",
    "react": "19.2.3",
    "react-dom": "19.2.3",
    "ws": "^8.18.3",
    "zxcvbn": "^4.4.2"
  },
  "devDependencies": {
    "@mdx-js/loader": "^3.1.1",
    "@mdx-js/react": "^3.1.1",
    "@microsoft/api-extractor": "^7.39.1",
    "@next/mdx": "^16.2.2",
    "@playwright/test": "^1.58.2",
    "@types/emscripten": "^1.40.1",
    "@types/node": "^20.5.9",
    "better-sqlite3": "^12.4.1",
    "concurrently": "^9.2.1",
    "esbuild": "^0.19.2",
    "eslint": "^9.38.0",
    "eslint-config-next": "16.1.6",
    "esno": "^0.17.0",
    "jsdom": "^29.0.1",
    "node-sqlite3-wasm": "^0.6.9",
    "promised-sqlite3": "^2.1.0",
    "sass": "^1.98.0",
    "sqlite3": "^5.1.6",
    "typescript": "^5.3.3"
  }
}
